<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.guilhermekaua.spigot-boot</groupId>
        <artifactId>spigot-boot-inventory-api-parent</artifactId>
        <version>3.1.0</version>
    </parent>

    <name>${project.artifactId}</name>
    <description>Version selector that dispatches to the matching per-version NMS title updater for the inventory API.</description>
    <url>https://github.com/guikaua12/spigot-boot</url>
    <artifactId>spigot-boot-inventory-api-nms</artifactId>

    <dependencies>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>

        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_8_R3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_12_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_16_R3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_17_R1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_18_R2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.guilhermekaua.spigot-boot</groupId>
            <artifactId>spigot-boot-inventory-api-nms-1_19_R3</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-nms-versions</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- bundle every per-version NMS impl into this single published jar. those
                                 modules cannot be standalone Central artifacts because they compile against
                                 the non-redistributable org.spigotmc:spigot. the reduced pom removes them so
                                 consumers never try to resolve them from Central; the selector picks the
                                 matching impl reflectively at runtime. nms-api stays a normal dependency. -->
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_8_R3</include>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_12_R1</include>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_16_R3</include>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_17_R1</include>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_18_R2</include>
                                    <include>tech.guilhermekaua.spigot-boot:spigot-boot-inventory-api-nms-1_19_R3</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
